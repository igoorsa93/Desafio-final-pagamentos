# ==========================================================================
# DESAFIO FINAL — Pipeline de pagamentos
# Neon (Postgres) → CDC Debezium → Kafka → Flink SQL → consumo
# Copie para .env e preencha antes de rodar ./setup.sh
# ==========================================================================

# --- Neon (Postgres) — aws/us-east-1 — Basic ---
NEON_DATABASE_NAME=desafio-final
NEON_DATABASE_URL=postgresql://desafio_pg:<NEON_PG_PASSWORD>@aws-0-us-east-1.neon.tech:5432/desafio-final?sslmode=require
NEON_CDC_USER=cdc_user
NEON_CDC_PASSWORD=<NEON_CDC_PASSWORD>

# --- Confluent Platform: Connect REST ---
CONNECT_REST_PORT=8083
CONNECT_HTTP_MAX_CONNECTIONS=100
CONNECT_PLUGIN_DIR=connectors

# --- Confluent Platform: Flink SQL ---
FLINK_JOBMANAGER_RPC_ADDRESS=localhost
FLINK_JOBMANAGER_RPC_PORT=6123
FLINK_REST_PORT=8081
FLINK_PARALLELISM=2
ARROW_PARALLEL=true
COSNOS_CHECKPOINT_STORAGE=default
COSNOS_DIAGNOSTICS_LOG_LEVEL=info

# --- Kafka / Schema Registry ---
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka-1:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Topics ---
PAYMENTS_TOPIC=desafio.payments
ENRICHED_TOPIC=desafio.payments.enriched
FRAUD_TOPIC=desafio.fraud.detected
